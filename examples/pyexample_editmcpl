#  Example showing how one can use the mcpl Python API to split an MCPL file
#  into several files and edit particle properties on the way, here moving the
#  neutrons and gammas from an input file into separate output files with a new
#  coordinate system, and changing all neutron wavelengths.

import sys

import mcpl
import numpy as np

infilename = sys.argv[1]

with mcpl.MCPLFile(infilename) as fi:

    #Create the output files, which get the same metadata as the input file:
    outfiles = {}
    for name, pdgcode in [('neutrons',2112), ('gammas',22)]:
        fo = mcpl.MCPLOutFile(f'{name}.mcpl')
        fo.transfer_metadata(fi)
        fo.hdr_add_comment(f'Selected {name}, rotated 90 degrees around the'
                           ' z axis and moved 10cm along it')
        outfiles[pdgcode] = fo
    outfiles[2112].hdr_add_comment('All neutrons have wavelength 1.8Aa')

    for block in fi.particle_blocks:
        for pdgcode, fo in outfiles.items():
            #Select the particles for this file:
            b = block[ block.pdgcode == pdgcode ]
            #Particle fields to change are given as keyword arguments together
            #with the block when adding particles. Values are computed from the
            #original values of the particles (so the rotation is correct):
            edits = { 'x' : -b.y, 'y' : b.x, 'z' : b.z + 10.0,
                      'ux' : -b.uy, 'uy' : b.ux }
            if pdgcode == 2112:
                #For neutrons and gammas, the wavelength [Aa] can be set
                #instead of the kinetic energy:
                edits['wavelength'] = 1.8
            fo.add_particles( b, **edits )

    for fo in outfiles.values():
        print(f'Wrote {fo.nparticles} particles to {fo.filename}')
        fo.close()

#Wavelengths can also be obtained from particles and blocks of particles with
#their wavelength attribute (which gives an error for particles which are not
#neutrons or gammas, so those must be selected first):
with mcpl.MCPLFile('neutrons.mcpl') as f:
    b = f.read_block()
    wl = b.wavelength
    print(f'Neutron wavelengths in neutrons.mcpl: {np.min(wl):.4g}Aa - {np.max(wl):.4g}Aa')
    print(f'1.8Aa neutrons have ekin = {b.ekin[0]*1e9:.4g}meV')

