Numbers with units:
  '5000eV' -> '5keV'
  '5keV' -> '5keV'
  '0.005MeV' -> '5keV'
  '0.5keV' -> '500eV'
  '1500eV' -> '1.5keV'
  '1e-12MeV' -> '0.001meV'
  '2.5e6TeV' -> '2500000TeV'
  '0keV' -> '0eV'
  '0.0MeV' -> '0eV'
  '10mm' -> '1cm'
  '0.5mm' -> '500um'
  '0.02m' -> '2cm'
  '1.8Aa' -> '1.8Aa'
  '20Aa' -> '2nm'
  '0.3nm' -> '3Aa'
  '1e5um' -> '10cm'
  '2000us' -> '2ms'
  '0.002s' -> '2ms'
  '5e-4ns' -> '0.0005ns'
  '4cm^2' -> '4cm^2'
  '40000mm^2' -> '400cm^2'
  '0.04m^2' -> '400cm^2'
  '2cm^-1' -> '2cm^-1'
  '0.02mm^-1' -> '20m^-1'
  '1e6m^-2' -> '1mm^-2'
  '0cm^2' -> '0m^2'
  '0m^-1' -> '0m^-1'
  '1cm^3' -> '1cm^3'
  '1e-3m^3' -> '1000cm^3'
  '0x10 mm' -> '1.6cm'
  '5.0keV' -> '5keV'
  '90.0deg' -> '90deg'
  '1.5rad' -> '1.5rad'
  '0rad' -> '0rad'
  '0deg' -> '0deg'
  '2.5mm^0.5' -> '2.5mm^0.5'
  '0cm^0.5' -> '0cm^0.5'
  '300K' -> '300K'
  '0.0K' -> '0K'
  '1e30eV' -> '1e+18TeV'
  '1e-30MeV' -> '1e-21meV'
  '1.5e20eV' -> '150000000TeV'
  '123456789012345678901234567890Aa' -> '1.2345678901234568e+16km'
  '-2.5mm' -> '-2.5mm'
  '-0.0m' -> '-0m'
  '25meV' -> '25meV'
  '0.025eV' -> '25meV'
  '1.1mm' -> '1.1mm'
  '12345.678km' -> '12345.678km'
All units: the same values, and normalising twice changes nothing
Particles and PDG codes:
  'pdgcode == 2112' -> 'pdgcode==neutron'
  'pdgcode == neutron' -> 'pdgcode==neutron'
  'pdgcode != -11' -> 'pdgcode!=positron'
  'pdgcode == antielectron' -> 'pdgcode==positron'
  'positron == pdgcode' -> 'positron==pdgcode'
  'pdgcode == 12345' -> 'pdgcode==12345'
  'pdgcode == 0x16' -> 'pdgcode==gamma'
  'x > neutron' -> 'x>2112'
  'x > -positron' -> 'x>--11'
  'abs(pdgcode) == 11' -> 'abs(pdgcode)==11'
  'abs(pdgcode) == electron' -> 'abs(pdgcode)==11'
  'pdgcode + 0 == 2112' -> 'pdgcode+0==2112'
  '0 < pdgcode == 22' -> '0<pdgcode==22'
  'pdgcode == photon or pdgcode == gamma' -> 'pdgcode==gamma or pdgcode==gamma'
  'pdgcode in (22, neutron, 2112, -11, 12345)' -> 'pdgcode in (positron,gamma,neutron,12345)'
  'pdgcode not in (antielectron, -11)' -> 'pdgcode not in (positron)'
  'abs(pdgcode) in (positron, 11, electron)' -> 'abs(pdgcode) in (-11,11)'
  'userflags in (0x10, 1, 16, 0x1)' -> 'userflags in (0x1,0x10)'
  'userflags in (16, 0x10)' -> 'userflags in (0x10)'
  'pdgcode == neutron and x > 0cm' -> 'pdgcode==neutron and x>0m'
  'pdgcode = 2112' -> 'pdgcode=neutron'
  'pdgcode = -11' -> 'pdgcode=positron'
  'pdgcode = antielectron' -> 'pdgcode=positron'
  'pdgcode += 1' -> 'pdgcode+=1'
  'pdgcode = 12345' -> 'pdgcode=12345'
  'x = neutron*1cm' -> 'x=2112*1cm'
Other expressions (only numbers with units and particles change):
  'r = hypot(x,y); r > 0.02m and r < 50mm' -> 'r=hypot(x,y);r>2cm and r<5cm'
  'ekin / MeV' -> 'ekin/MeV'
  '(x**2 + y^2) / cm^2' -> '(x^2+y^2)/cm^2'
  '2*MeV' -> '2*MeV'
  '0x1F' -> '0x1f'
  '2.0' -> '2.0'
  '2e0' -> '2.0'
  'not (x > 0cm)' -> 'not x>0m'
  'mod(userflags,2) == 0' -> 'mod(userflags,2)==0'
  'x += 10mm; ekin = 0.025eV; pdgcode = 2112' -> 'x+=1cm;ekin=25meV;pdgcode=neutron'
  'rotate_z(90.0deg); pos += (0,0,1e3mm)' -> 'rotate_z(90deg);pos+=(0,0,1m)'
  Value(expr=Quantity(number=Float(value=2000.0), unit='eV', power=1))
    -> Value(expr=Quantity(number=Int(value=2, hex=False), unit='keV', power=1))
  Value(expr=Compare(first=Name(id='pdgcode'), ops=('==',), values=(Unary(op='-', operand=Int(value=11, hex=False)),)))
    -> Value(expr=Compare(first=Name(id='pdgcode'), ops=('==',), values=(Particle(name='positron'),)))
  Value(expr=In(value=Name(id='pdgcode'), negated=False, values=(Int(value=22, hex=False), Particle(name='photon'), Int(value=-11, hex=False))))
    -> Value(expr=In(value=Name(id='pdgcode'), negated=False, values=(Particle(name='positron'), Particle(name='gamma'))))
  Value(expr=Binary(op='*', left=Particle(name='neutron'), right=Quantity(number=Int(value=0, hex=False), unit='mm', power=2)))
    -> Value(expr=Binary(op='*', left=Int(value=2112, hex=False), right=Quantity(number=Int(value=0, hex=False), unit='m', power=2)))
