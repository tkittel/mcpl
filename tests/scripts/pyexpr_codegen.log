static uint64_t add_u64( uint64_t a, uint64_t b )
{
  if ( a > UINT64_MAX - b ) {
    fprintf( stderr, "ERROR: Integer overflow\n" );
    exit( 1 );
  }
  return a + b;
}

static double check_finite( double v )
{
  if ( !isfinite( v ) ) {
    fprintf( stderr, "ERROR: NaN or infinite value\n" );
    exit( 1 );
  }
  return v;
