          check_finite( p.ekin() ) < 10.0/*10MeV*/ &&
          check_finite( p.weight() ) > 0.001 ) ||
          check_finite( check_finite( check_finite( check_finite( check_finite( check_finite(
          check_finite( check_finite( p.x() ) +
          check_finite( p.y() ) ) + check_finite( p.z() ) ) / 1.0/*cm*/ ) *
          check_finite( p.ux() ) ) * check_finite( p.uy() ) ) * check_finite( p.uz() ) ) /
          check_finite( check_finite( check_finite( p.ekin() ) / 1.0/*MeV*/ ) +
          static_cast<double>( 1 ) ) ) > check_finite( check_finite( check_finite( check_finite(
          check_finite( std::sqrt( check_finite( check_finite( check_finite( p.x() ) *
          check_finite( p.x() ) ) + check_finite( check_finite( p.y() ) *
          check_finite( p.y() ) ) ) ) ) / 1.0/*cm*/ ) *
          check_finite( std::sqrt( check_finite( check_finite( p.ekin() ) / 1.0/*MeV*/ ) ) ) ) +
          check_finite( check_finite( check_finite( p.polx() ) * check_finite( p.poly() ) ) *
          check_finite( p.polz() ) ) ) + check_finite( check_finite( p.time() ) /
          1.0/*ms*/ ) ) ) ) )
        continue;
      fout.transfer_last_read_particle( fin );
    }
    fout.close();
    fin.close();
  } catch ( const std::runtime_error& e ) {
    std::cerr << "ERROR: " << e.what() << std::endl;
    return 1;
  }
  return 0;
}
