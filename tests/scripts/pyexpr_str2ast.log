Precedence and associativity:
  'a or b and c'                     -> (or a (and b c))   written: 'a or b and c'
  'a and b or c'                     -> (or (and a b) c)   written: 'a and b or c'
  'not a and b'                      -> (and (not a) b)   written: 'not a and b'
  'not a == b'                       -> (not (cmp a == b))   written: 'not a==b'
  'not not a'                        -> (not (not a))   written: 'not not a'
  'a | b & c'                        -> (| a (& b c))   written: 'a|b&c'
  'a & b | c'                        -> (| (& a b) c)   written: 'a&b|c'
  'a & 1 == 0'                       -> (cmp (& a 1) == 0)   written: 'a&1==0'
  'a | b == c'                       -> (cmp (| a b) == c)   written: 'a|b==c'
  'a + b * c'                        -> (+ a (* b c))   written: 'a+b*c'
  'a * b + c'                        -> (+ (* a b) c)   written: 'a*b+c'
  'a - b - c'                        -> (- (- a b) c)   written: 'a-b-c'
  'a - (b - c)'                      -> (- a (- b c))   written: 'a-(b-c)'
  'a / b / c'                        -> (/ (/ a b) c)   written: 'a/b/c'
  'a // b * c'                       -> (* (// a b) c)   written: 'a//b*c'
  'a * b // c'                       -> (// (* a b) c)   written: 'a*b//c'
  '-a ^ 2'                           -> (neg (^ a 2))   written: '-a^2'
  '(-a) ^ 2'                         -> (^ (neg a) 2)   written: '(-a)^2'
  'a ^ b ^ c'                        -> (^ a (^ b c))   written: 'a^b^c'
  '(a ^ b) ^ c'                      -> (^ (^ a b) c)   written: '(a^b)^c'
  'a ^ -b'                           -> (^ a (neg b))   written: 'a^-b'
  '2 ^ -x ^ 2'                       -> (^ 2 (neg (^ x 2)))   written: '2^-x^2'
  'a ** b'                           -> (^ a b)   written: 'a^b'
  '-(a + b)'                         -> (neg (+ a b))   written: '-(a+b)'
  '+a'                               -> (pos a)   written: '+a'
  '- - a'                            -> (neg (neg a))   written: '--a'
  '-a * b'                           -> (* (neg a) b)   written: '-a*b'
  'a < b < c'                        -> (cmp a < b < c)   written: 'a<b<c'
  'a == b != c'                      -> (cmp a == b != c)   written: 'a==b!=c'
  'a <= b >= c'                      -> (cmp a <= b >= c)   written: 'a<=b>=c'
  '(a < b) == c'                     -> (cmp (cmp a < b) == c)   written: '(a<b)==c'
  'a < b and b < c'                  -> (and (cmp a < b) (cmp b < c))   written: 'a<b and b<c'
Units:
  '25meV'                            -> (* 25 <meV>)   written: '25meV'
  '25 meV'                           -> (* 25 <meV>)   written: '25meV'
  '1e3cm'                            -> (* 1000.0 <cm>)   written: '1000.0cm'
  '0.5m'                             -> (* 0.5 <m>)   written: '0.5m'
  'x/cm'                             -> (/ x <cm>)   written: 'x/cm'
  'MeV'                              -> <MeV>   written: 'MeV'
  '4cm^2'                            -> (* 4 <cm^2>)   written: '4cm^2'
  '2cm^-1 * x'                       -> (* (* 2 <cm^-1>) x)   written: '2cm^-1*x'
  'cm^(1/2)'                         -> <cm^0.5>   written: 'cm^0.5'
  'cm^-0.5'                          -> <cm^-0.5>   written: 'cm^-0.5'
  'cm^2.5'                           -> <cm^2.5>   written: 'cm^2.5'
  'cm^+2'                            -> <cm^2>   written: 'cm^2'
  'cm^--2'                           -> <cm^2>   written: 'cm^2'
  '2^(x)MeV'                         -> (* (^ 2 x) <MeV>)   written: '2^x*MeV'
  '(a + b)cm'                        -> (* (+ a b) <cm>)   written: '(a+b)cm'
  '1/cm^2'                           -> (/ 1 <cm^2>)   written: '1/cm^2'
  'x > 0'                            -> (cmp x > 0)   written: 'x>0'
  'x > 2cm - 1mm'                    -> (cmp x > (- (* 2 <cm>) (* 1 <mm>)))   written: 'x>2cm-1mm'
  'ekin/MeV ^ 2'                     -> (/ ekin <MeV^2>)   written: 'ekin/MeV^2'
  'deg'                              -> <deg>   written: 'deg'
Vectors and their values:
  '(a,b)'                            -> [a, b]   written: '(a,b)'
  '(a,b,c)'                          -> [a, b, c]   written: '(a,b,c)'
  '(0,0,1m)'                         -> [0, 0, (* 1 <m>)]   written: '(0,0,1m)'
  'pos.x'                            -> (at pos 0)   written: 'pos.x'
  'pos.y.z'                          -> (at (at pos 1) 2)   written: 'pos.y.z'
  'pos.at(2)'                        -> (at pos 2)   written: 'pos.z'
  '(x,y,z).y'                        -> (at [x, y, z] 1)   written: '(x,y,z).y'
  'dir.x ^ 2'                        -> (^ (at dir 0) 2)   written: 'dir.x^2'
  '-pos.x'                           -> (neg (at pos 0))   written: '-pos.x'
  'f(a,b)'                           -> f(a, b)   written: 'f(a,b)'
  'f()'                              -> f()   written: 'f()'
  'abs((0,0,1m))'                    -> abs([0, 0, (* 1 <m>)])   written: 'abs((0,0,1m))'
  'dot(dir,(0,0,1))'                 -> dot(dir, [0, 0, 1])   written: 'dot(dir,(0,0,1))'
  'f(g(a))'                          -> f(g(a))   written: 'f(g(a))'
Userdata fields:
  'userdata.temp'                    -> userdata.temp   written: 'userdata.temp'
  'userdata.d.at(1)'                 -> userdata.d.at(1)   written: 'userdata.d.at(1)'
  'userdata.temp > 300K'             -> (cmp userdata.temp > (* 300 <K>))   written: 'userdata.temp>300K'
  '-userdata.n ^ 2'                  -> (neg (^ userdata.n 2))   written: '-userdata.n^2'
In and not in:
  'pdgcode in (neutron,gamma)'       -> (cmp pdgcode in [neutron, gamma])   written: 'pdgcode in (neutron,gamma)'
  'x not in (1,2)'                   -> (cmp x not in [1, 2])   written: 'x not in (1,2)'
  'a in (b)'                         -> (cmp a in [b])   written: 'a in (b)'
  'not a in (1,2)'                   -> (not (cmp a in [1, 2]))   written: 'not a in (1,2)'
  'a + 1 in (2,3) and b'             -> (and (cmp (+ a 1) in [2, 3]) b)   written: 'a+1 in (2,3) and b'
Numbers (decimal and hexadecimal, as in C):
  '0'                                -> 0   written: '0'
