  '007.5'                            -> 7.5   written: '7.5'
  '1eV'                              -> (* 1 <eV>)   written: '1eV'
Statements of edits:
  'x = 1cm'                          -> {(= x (* 1 <cm>))}   written: 'x=1cm'
  'x += 2'                           -> {(+= x 2)}   written: 'x+=2'
  'x -= y'                           -> {(-= x y)}   written: 'x-=y'
  'x *= 2'                           -> {(*= x 2)}   written: 'x*=2'
  'x /= 2'                           -> {(/= x 2)}   written: 'x/=2'
  'x //= 2'                          -> {(//= x 2)}   written: 'x//=2'
  'x ^= 2'                           -> {(^= x 2)}   written: 'x^=2'
  'x **= 2'                          -> {(^= x 2)}   written: 'x^=2'
  'x &= 3'                           -> {(&= x 3)}   written: 'x&=3'
  'x |= 4'                           -> {(|= x 4)}   written: 'x|=4'
  'tmp = x + y'                      -> {(= tmp (+ x y))}   written: 'tmp=x+y'
  'swap(x,y)'                        -> {swap(x, y)}   written: 'swap(x,y)'
  'rotate_z(90deg)'                  -> {rotate_z((* 90 <deg>))}   written: 'rotate_z(90deg)'
  'pos += (0,0,1m)'                  -> {(+= pos [0, 0, (* 1 <m>)])}   written: 'pos+=(0,0,1m)'
  'x > 0'                            -> {(cmp x > 0)}   written: 'x>0'
