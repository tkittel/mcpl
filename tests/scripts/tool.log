// Edit: x+=1cm;weight*=2
// Code generated by MCPL from the edit expression above

#include "mcplcpp.h"
#include <cmath>
#include <iostream>

static double check_finite( double v )
{
  if ( !std::isfinite( v ) )
    throw std::runtime_error( "NaN or infinite value" );
  return v;
}

int main( int argc, char ** argv )
{
  if ( argc != 3 ) {
    std::cout << "Usage: " << argv[0] << " INPUT.mcpl OUTPUT.mcpl" << std::endl;
    return 1;
  }
  try {
    mcpl::MCPLFile fin( argv[1] );
    mcpl::MCPLOutFile fout( argv[2] );
    fout.transfer_metadata( fin );
    fout.add_comment( "mcpltool: extracted particles with -e \"x+=1cm;weight*=2\"" );
    const double universal_weight = fin.universal_weight();
    auto out = fout.new_particle();
    for ( auto p : fin ) {
      out.set_position( p.position() );
      out.set_direction( p.direction() );
      out.set_polarisation( p.polarisation() );
      out.set_ekin( p.ekin() );
      out.set_time( p.time() );
      out.set_weight( p.weight() );
      out.set_pdgcode( p.pdgcode() );
      out.set_userflags( p.userflags() );
      out.set_x( check_finite( check_finite( out.x() ) + 1.0/*1cm*/ ) );
      out.set_weight( check_finite( check_finite( out.weight() ) * static_cast<double>( 2 ) ) );
      if ( universal_weight && out.weight() != universal_weight ) {
        throw std::runtime_error( "The weight can not be changed in files with a universal "
                                  "weight" );
      }
      fout.add( out );
    }
    fout.close();
    fin.close();
  } catch ( const std::runtime_error& e ) {
    std::cerr << "ERROR: " << e.what() << std::endl;
    return 1;
  }
  return 0;
}

