/* Edit: pdgcode==neutron and ekin>5keV */
/* Code generated by MCPL from the edit expression above */

#include "mcpl.h"
#include <math.h>
#include <stdio.h>
#include <stdlib.h>

static double check_finite( double v )
{
  if ( !isfinite( v ) ) {
    fprintf( stderr, "ERROR: NaN or infinite value\n" );
    exit( 1 );
  }
  return v;
}

int main( int argc, char ** argv )
{
  if ( argc != 3 ) {
    printf( "Usage: %s INPUT.mcpl OUTPUT.mcpl\n", argv[0] );
    return 1;
  }
  mcpl_file_t fi = mcpl_open_file( argv[1] );
  mcpl_outfile_t fo = mcpl_create_outfile( argv[2] );
  mcpl_transfer_metadata( fi, fo );
  mcpl_hdr_add_comment( fo, "mcpltool: extracted particles with -e \"pdgcode==neutron and "
                            "ekin>5keV\"" );
  const mcpl_particle_t * p_in;
  while ( ( p_in = mcpl_read( fi ) ) ) {
    if ( !( ( p_in->pdgcode == 2112/*neutron*/ && check_finite( p_in->ekin ) > 0.005/*5keV*/ ) ) )
      continue;
    mcpl_transfer_last_read_particle( fi, fo );
  }
  mcpl_close_outfile( fo );
  mcpl_close_file( fi );
  return 0;
}

