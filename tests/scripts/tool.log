#include "mcpl.h"
#include <stdio.h>
#include <stdlib.h>

int main( int argc, char ** argv )
{
  if ( argc != 3 ) {
    printf( "Usage: %s INPUT.mcpl OUTPUT.mcpl\n", argv[0] );
    return 1;
  }
  mcpl_file_t fi = mcpl_open_file( argv[1] );
  mcpl_outfile_t fo = mcpl_create_outfile( argv[2] );
  mcpl_transfer_metadata( fi, fo );
  mcpl_hdr_add_comment( fo, "mcpltool: extracted particles with -e \"userdata.temp>300K;"
                            "ekin=userdata.e\"" );
  const char * layout = mcpl_hdr_userdata_layout( fi );
  const uint32_t offset_temp = mcpl_userdata_offset( layout, "temp", "float32" );
  const uint32_t offset_e = mcpl_userdata_offset( layout, "e", "float64" );
  const mcpl_particle_t * p_in;
  const uint8_t * ud;
  while ( ( p_in = mcpl_read_with_userdata( fi, &ud ) ) ) {
    mcpl_particle_t p = *p_in;
    if ( !( mcpl_userdata_get_float32( ud, offset_temp ) > 300.0/*300K*/ ) )
      continue;
    p.ekin = mcpl_userdata_get_float64( ud, offset_e );
    mcpl_add_particle_with_userdata( fo, &p, ud );
  }
  mcpl_close_outfile( fo );
  mcpl_close_file( fi );
  return 0;
}

